+        llm_decision_interval=LLM_DECISION_INTERVAL,
+        llm_model=LLM_MODEL,
+        llm_base_url=LLM_BASE_URL,
+        llm_api_key=LLM_API_KEY,
+        prompt_version="v2-stage-separated",
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
